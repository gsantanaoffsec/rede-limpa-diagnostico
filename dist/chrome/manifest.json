{
  "manifest_version": 3,
  "name": "Rede limpa + Diagnóstico",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "Capture e compare pesquisas HTTP, analise filtros, revise dados e exporte diagnósticos locais. Ocultação e bloqueio de hosts.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite",
    "debugger",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Rede limpa + Diagnóstico",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "devtools_page": "devtools.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kaspersky_polling",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
