{
  "manifest_version": 2,
  "name": "Rede limpa + Diagnóstico",
  "version": "2.0.0",
  "description": "Capture e compare pesquisas HTTP, analise filtros, revise dados e exporte diagnósticos locais. Ocultação e bloqueio de hosts.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "activeTab",
    "clipboardWrite",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "network-core.js",
      "diagnostic-core.js",
      "insights.js",
      "capture-session.js",
      "extension-ui.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Rede limpa + Diagnóstico",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "diagnostico-requisicoes@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "devtools_page": "devtools.html"
}
